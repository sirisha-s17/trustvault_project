PORT=3000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173
STORAGE_DIR=./private-storage
# disk (default) or gridfs (store files in MongoDB; use on Render free plan)
STORAGE_DRIVER=disk
MAX_UPLOAD_BYTES=26214400
# Set to 1 when deployed behind one reverse proxy/load balancer (Render, Railway, Heroku, Nginx)
TRUST_PROXY=0
